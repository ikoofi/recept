<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Тёмная тема Android: по ней сайт понимает, что выбран ночной режим (prefers-color-scheme). -->
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/night_bar</item>
        <item name="android:statusBarColor">@color/night_bar</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/night_bar</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
